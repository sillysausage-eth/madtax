# ---------------------------------------------------------------------------
# Tax Truth environment variables
#
# Local dev:  copy this file to .env.local and fill in the values.
#             .env.local is git-ignored. Never commit real keys.
# Deployed:   set the same keys in Vercel → Settings → Environment Variables.
# CI / ETL:   set the two server-only keys in
#             GitHub → Settings → Secrets and variables → Actions.
#
# The project ref below (aiompjijqoyjnighvgfv) is the Supabase project already connected
# to this repo via .mcp.json. Keys come from Supabase → Project Settings → API,
# and the database URL from → Database.
# ---------------------------------------------------------------------------

# --- Public. Sent to the browser. Safe by design: protected by row-level security. ---
NEXT_PUBLIC_SUPABASE_URL=https://aiompjijqoyjnighvgfv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only. NEVER prefix these with NEXT_PUBLIC_. ---
# Bypasses row-level security. Used by ingestion and server-side routes only.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection, used by the ETL loaders.
SUPABASE_DB_URL=postgresql://postgres:[password]@db.aiompjijqoyjnighvgfv.supabase.co:5432/postgres

# --- Optional ---
# The site's public origin, no trailing slash. Used for canonical URLs, hreflang
# links, the sitemap and Open Graph image URLs. Set this as soon as the domain is
# known; until then Vercel's own host is used, and localhost in development.
NEXT_PUBLIC_SITE_URL=
# Storage bucket holding the immutable archive of every downloaded source file.
SUPABASE_STORAGE_BUCKET=madtax-sources
# Default locale: es | en
NEXT_PUBLIC_DEFAULT_LOCALE=es
